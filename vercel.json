{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix v3 install",
  "buildCommand": "npm --prefix v3 run build",
  "outputDirectory": "v3/dist",
  "headers": [
    {
      "source": "/(index.html|/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
